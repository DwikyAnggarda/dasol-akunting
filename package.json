{
  "name": "dasol-accounting",
  "version": "0.1.0",
  "description": "Dasol multi-company accounting application",
  "private": true,
  "engines": {
    "node": ">=20.20.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --local --level error",
    "db:types": "supabase gen types typescript --local > src/types/database.generated.ts",
    "docs:screenshots": "node scripts/capture-user-guide-screenshots.mjs",
    "docs:validate": "node scripts/validate-user-guide.mjs",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "verify:accounting": "tsx scripts/verify-accounting.ts"
  },
  "dependencies": {
    "@fullcalendar/core": "6.1.19",
    "@fullcalendar/daygrid": "6.1.19",
    "@fullcalendar/interaction": "6.1.19",
    "@fullcalendar/list": "6.1.19",
    "@fullcalendar/react": "6.1.19",
    "@fullcalendar/timegrid": "6.1.19",
    "@react-jvectormap/core": "1.0.4",
    "@react-jvectormap/world": "1.1.2",
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.109.0",
    "@tailwindcss/postcss": "4.3.3",
    "apexcharts": "4.7.0",
    "autoprefixer": "10.4.22",
    "decimal.js": "10.6.0",
    "dotenv": "17.4.2",
    "flatpickr": "4.6.13",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-apexcharts": "1.9.0",
    "react-dom": "19.2.8",
    "react-dropzone": "14.3.8",
    "server-only": "0.0.1",
    "tailwind-merge": "2.6.0",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.3",
    "@playwright/test": "1.62.1",
    "@svgr/webpack": "8.1.0",
    "@types/node": "20.19.26",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/react-transition-group": "4.4.12",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.0",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "2.113.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@react-jvectormap/core": {
      "react": "^16.8.0 || ^17 || ^18 || ^19",
      "react-dom": "^16.8.0 || ^17 || ^18 || ^19"
    },
    "@react-jvectormap/world": {
      "react": "^16.8.0 || ^17 || ^18 || ^19",
      "react-dom": "^16.8.0 || ^17 || ^18 || ^19"
    }
  }
}
